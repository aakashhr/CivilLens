# Copy this file to .env and fill in ONE of the LLM options.
# LLM_PROVIDER: auto | groq | gemini | ollama | offline
LLM_PROVIDER=auto

# Groq (free key: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Google Gemini (free key: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Ollama (local, no key): install Ollama, run "ollama pull llama3.1"
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Toxicity backend: auto | detoxify | local      Embeddings: auto | sbert | tfidf
TOXICITY_BACKEND=auto
EMBEDDING_BACKEND=auto
